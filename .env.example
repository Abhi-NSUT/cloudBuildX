# Local development defaults (match docker-compose.yml)
# Copy to .env (API) and worker/.env (Worker)

DATABASE_URL=postgresql://admin:strongpassword123@localhost:5432/cloudbuildx?schema=public

# Redis: set REDIS_URL for a hosted instance (e.g. Upstash), otherwise host/port are used
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=

# Local S3 (MinIO). Leave AWS_* unset to use MinIO.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=strongpassword123
S3_BUCKET_NAME=cloudbuildx-artifacts

# Production S3 (setting AWS_ACCESS_KEY_ID switches from MinIO to AWS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

JWT_SECRET=change-me

# Logging: debug | info | warn | error (NODE_ENV=production switches to JSON logs)
LOG_LEVEL=info
